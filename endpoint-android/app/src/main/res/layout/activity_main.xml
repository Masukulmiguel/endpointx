<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EndpointX Agent"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1D4ED8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assistência remota: depois de registado, o técnico pode ver e controlar este dispositivo a partir da consola."
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_server"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://endpointx.onrender.com"
            android:inputType="textUri"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_device_name"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/deviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Telemóvel de suporte"
            android:inputType="text"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_enroll_token"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/enrollToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="..."
            android:inputType="text"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_register"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_share" />

            <Button
                android:id="@+id/btnStopShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_stop_share" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAllowRestricted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_allow_restricted"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_control"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_battery"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hint_control"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="#F3F4F6"
            android:textColor="#111827"
            android:textSize="12sp"
            android:typeface="monospace"
            android:text="@string/status_idle" />
    </LinearLayout>
</ScrollView>
