# PostgreSQL
POSTGRES_DB=endpointx
POSTGRES_USER=endpointx
POSTGRES_PASSWORD=endpointx_secret

# Redis
REDIS_PASSWORD=redis_secret

# Backend
NODE_ENV=development
SEED_ADMIN_PASSWORD=
JWT_SECRET=change_this_in_production_very_long_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_very_long_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=32_char_encryption_key_here_!
AGENT_SECRET=agent_shared_secret_here
FRONTEND_URL=http://localhost:5173

# Device presence (seconds without heartbeat before a device is marked offline)
OFFLINE_THRESHOLD=300
# Mobile/PWA presence: browsers freeze page timers with the screen locked,
# so phones get a much longer grace period before they flip to offline
MOBILE_OFFLINE_THRESHOLD=1800

# Rate limits (per 15-minute window)
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20
# Heartbeat limits: first per device (agent_id), then a safety net per source IP
HEARTBEAT_RATE_LIMIT_MAX=300
HEARTBEAT_RATE_LIMIT_IP_MAX=1000

# SMTP (optional - for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# HERMES AI (free models)
# OpenCode Zen free tier only works from within OpenCode clients.
# Prefer OpenRouter free key (openrouter.ai, no credit card) for the backend.
OPENCODE_SERVER_URL=
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=mimo-v2.6-flash-free
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
