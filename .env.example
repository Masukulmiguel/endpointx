# PostgreSQL
POSTGRES_DB=endpointx
POSTGRES_USER=endpointx
POSTGRES_PASSWORD=endpointx_secret

# Redis
REDIS_PASSWORD=redis_secret

# Backend
NODE_ENV=development
JWT_SECRET=change_this_in_production_very_long_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_very_long_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=32_char_encryption_key_here_!
AGENT_SECRET=agent_shared_secret_here
FRONTEND_URL=http://localhost:5173

# SMTP (optional - for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
